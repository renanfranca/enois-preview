{
  "name": "enois-preview",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run build && node --test dist/test/*.test.js",
    "dev": "npm run build && wrangler dev",
    "check": "npm run build && wrangler deploy --dry-run",
    "deploy": "npm run build && node dist/scripts/check-release.js && wrangler deploy",
    "example:prepare": "npm run build && node dist/example/prepare.js",
    "build": "rm -rf dist && tsc -p tsconfig.json && tsc -p tsconfig.cloudflare.json && node dist/scripts/build-assets.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.cloudflare.json",
    "test:example": "npm run build && node --test dist/test/integration/example.test.js",
    "test:image": "npm run build && node --test dist/test/integration/image.test.js",
    "test:capture": "npm run build && node --test dist/test/integration/capture.test.js",
    "test:install": "npm run build && node --test dist/test/integration/install-tool.test.js",
    "test:memory": "npm run build && node --test dist/test/integration/gateway-memory.test.js",
    "test:startup": "npm run build && node --test dist/test/integration/startup.test.js",
    "test:flows": "npm run build && node --test dist/test/integration/application-flows.test.js",
    "test:effects": "npm run build && node --test dist/test/integration/application-effects.test.js",
    "test:capacity": "npm run build && node --test dist/test/integration/capacity.test.js",
    "test:media": "npm run build && node --test dist/test/integration/media-contracts.test.js",
    "test:layers": "npm run build && node --test dist/test/integration/image-security.test.js",
    "test:consumer": "npm run build && node --test dist/test/integration/consumer-build.test.js",
    "test:worker-upload": "npm run build && node --test dist/test/integration/worker-upload.test.js"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "miniflare": "5.20261023.3-beta",
    "playwright": "1.64.1",
    "typescript": "5.9.3",
    "wrangler": "4.156.0"
  },
  "bin": {
    "enois-preview": "dist/preview/cli.js"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "version": "0.3.2",
  "license": "GPL-3.0-only",
  "exports": {
    "./cli": "./dist/preview/cli.js",
    "./worker": "./dist/src/worker.js"
  },
  "dependencies": {
    "tar": "7.5.22",
    "tough-cookie": "6.0.2"
  },
  "files": [
    "dist",
    "preview",
    "shared",
    "src",
    "runtime",
    "recipe",
    "example",
    "scripts",
    "test",
    "docs",
    "release",
    "tsconfig.json",
    "tsconfig.cloudflare.json",
    "wrangler.jsonc",
    "catalog/scenarios.json",
    "TUTORIAL.md",
    "VALIDATION.md",
    ".nvmrc"
  ]
}
